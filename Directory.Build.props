<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <UseLocalBuildingBlocks Condition="'$(UseLocalBuildingBlocks)' == ''">true</UseLocalBuildingBlocks>
    <LocalBuildingBlocksProject>$(MSBuildThisFileDirectory)..\fcg-dotnet-building-blocks\src\FiapCloudGames.BuildingBlocks\FiapCloudGames.BuildingBlocks.csproj</LocalBuildingBlocksProject>
  </PropertyGroup>

  <Target Name="ValidateLocalBuildingBlocks"
          BeforeTargets="PrepareForBuild"
          Condition="'$(UseLocalBuildingBlocks)' == 'true'">
    <Error Condition="!Exists('$(LocalBuildingBlocksProject)')"
           Text="UseLocalBuildingBlocks=true, mas o projeto local não foi encontrado em '$(LocalBuildingBlocksProject)'." />
    <Message Importance="high"
             Text="Usando FiapCloudGames.BuildingBlocks local: $(LocalBuildingBlocksProject)" />
  </Target>
</Project>
